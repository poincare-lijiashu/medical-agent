<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志格式：显式带 traceId（MDC 键 tid，由 TraceMdcFilter 从网关注入的 X-Trace-Id 写入）。
  用途（M12）：出问题时可从一条错误日志直接定位到 SkyWalking 的同一条链路，
  反之亦可；Loki 侧用 `{container="..."} |= "<traceId>"` 检索，不把 traceId 做成标签
  （高基数标签会拖垮 Loki 索引）。

  说明：不引第三方 encoder，保持与 Spring Boot 默认控制台输出风格一致；
  无 traceId（定时任务/启动期）时输出空方括号。
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="medassist"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${APP_NAME}] [%X{tid:-}] %logger{36} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>

  <logger name="com.medassist" level="DEBUG"/>
</configuration>
