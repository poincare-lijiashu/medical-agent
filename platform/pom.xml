<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.medassist</groupId>
  <artifactId>medassist-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>MedAssist Platform</name>
  <description>全院级 HIS 平台（Java 业务微服务矩阵）+ Python AI 中台</description>

  <!--
    版本基线（2026-10-30 经 repo1.maven.org maven-metadata.xml 核实，非凭记忆）：
      Spring Boot          4.0.9   （4.0.x 最新补丁；4.1.x/4.2.x 与 Spring Cloud 适配线不同，暂不跟进）
      Spring Cloud         2025.1.4（2025.1.x = Oakwood，官方适配 Boot 4.0.x）
      Spring Cloud Alibaba 2025.1.0.0（官方适配 Boot 4.0.x / Cloud 2025.1.x）
      Java                 21 LTS （本机 Temurin 21.0.12；计划书基线为"最低 21 / 首选 25"）
  -->
  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>4.0.9</spring-boot.version>
    <spring-cloud.version>2025.1.4</spring-cloud.version>
    <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>

    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <jacoco.version>0.8.12</jacoco.version>

    <!--
      HAPI FHIR R4（8.12.1，2026-11 经 repo1.maven.org maven-metadata.xml 核实）。
      只引入 structures（资源模型 + JSON/XML 序列化），不引入 hapi-fhir-server：
      后者基于 JAX-RS，与 Spring MVC 的鉴权/审计/错误壳需要重写适配，收益低于成本。
    -->
    <hapi-fhir.version>8.12.1</hapi-fhir.version>

    <!--
      dcm4che（DICOM 工具包，5.35.2，2026-11 经 maven.dcm4che.org 实测可解析）。
      只用于 DIMSE（C-ECHO/C-FIND/C-STORE/C-MOVE）网关；DICOMweb 仍走既有 HTTP 客户端。
      注意：该构件不在 Maven Central，仅在 dcm4che 官方仓库（见 tech/pom.xml）；
      5.36.0 的模块已发布但父 POM 缺失，构建无法解析，故取 5.35.2。
    -->
    <dcm4che.version>5.35.2</dcm4che.version>
  </properties>

  <modules>
    <module>common</module>
    <module>gateway</module>
    <module>auth</module>
    <module>empi</module>
    <module>clinical</module>
    <module>pharmacy</module>
    <module>material</module>
    <module>tech</module>
    <module>emr</module>
    <module>insurance</module>
    <module>kb</module>
    <module>fhir</module>
    <module>masterdata</module>
    <module>migration</module>
    <module>ops</module>
    <module>release</module>
    <module>license</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.alibaba.cloud</groupId>
        <artifactId>spring-cloud-alibaba-dependencies</artifactId>
        <version>${spring-cloud-alibaba.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <!-- 本项目 parent 为自建 POM（非 spring-boot-starter-parent），repackage 需显式绑定：
               否则产物为普通瘦 jar，无法 java -jar 独立运行（实测首轮 jar 仅数十 KB）。 -->
          <executions>
            <execution>
              <id>repackage</id>
              <goals>
                <goal>repackage</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <!-- 必须显式开启：自建 parent 不具备 spring-boot-starter-parent 的默认配置，
                 缺少 -parameters 时 Spring MVC 无法反射参数名，
                 实测报 "Name for argument of type [String] not specified"（500）。 -->
            <parameters>true</parameters>
            <compilerArgs>
              <arg>-Xlint:all</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            真库集成测试（Testcontainers，@Tag("postgres")）默认不执行：
            CI/开发机没有 Docker 时不能因此让 `mvn test` 失败。
            需要时用 `mvn -Ppostgres-it test` 单独运行。
          -->
          <excludedGroups>postgres</excludedGroups>
        </configuration>
      </plugin>
      <!--
        评测 E7-L4（2026-11-13）：此前 JaCoCo 只在 pluginManagement 声明版本，
        从未绑定执行 → "Java 侧覆盖率"根本不可知，回归风险不可见。
        现在默认构建产出覆盖率报告；阈值门禁用 `mvn -Pcoverage-gate verify` 开启，
        避免存量低覆盖模块一次性把流水线打红（阈值由 CI 逐步收紧）。
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      覆盖率门禁（评测 E7-L4）：
        mvn -Pcoverage-gate verify
      只对"有测试的模块"生效（common 等纯技术模块按需排除），阈值先给到 50% 行覆盖，
      CI 跑通后再逐步收紧；默认构建只出报告不阻断，避免存量低覆盖一次性打红。
    -->
    <profile>
      <id>coverage-gate</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>check</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.50</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      真库 SQL 级集成测试（意见书 P1-4 / §5.1）：
        mvn -Ppostgres-it -pl clinical -am test
      用 Testcontainers 起一次性 PostgreSQL，跑**真实迁移文件**建 schema，
      验证 mock 单测覆盖不到的 SQL 语义（CAS、容量守卫、累计上限、部分唯一索引、并发限流）。
      镜像 postgres:15-alpine 需本地已存在（离线环境不拉取）。
      G63：必须显式 include **/*IT.java —— surefire 默认只收 *Test/*Tests/*TestCase，
      此前 *IT 从未被执行（`Tests run: 0` 也返回 BUILD SUCCESS，等于门禁空转）。
    -->
    <profile>
      <id>postgres-it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludedGroups combine.self="override">__none__</excludedGroups>
              <groups>postgres</groups>
              <includes>
                <include>**/*IT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      生产打包：物理排除 application-dev.yml。
      背景：dev 配置位于 src/main/resources，默认会被打进 jar；其中内部接口令牌是仓库公开常量，
      一旦误带 dev profile 上线，等于内部接口裸奔。生产构建务必加 -Pprod-package：
          mvn -Pprod-package -DskipTests package
      （运行时另有守卫：prod/production/staging/k8s profile 或在 K8s 集群内，
        使用开发默认 JWT 密钥会直接拒绝启动。）
    -->
    <profile>
      <id>prod-package</id>
      <build>
        <resources>
          <resource>
            <directory>src/main/resources</directory>
            <excludes>
              <exclude>application-dev.yml</exclude>
              <exclude>application-local.yml</exclude>
            </excludes>
          </resource>
        </resources>
      </build>
    </profile>
  </profiles>
</project>
