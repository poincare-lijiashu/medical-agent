{
  "uid": "medassist-overview",
  "title": "MedAssist · AI 中台总览",
  "tags": ["medassist", "ai-core"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["30s", "1m", "5m", "15m"] },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "问答 QPS（按能力域）",
      "description": "rate(consult_requests_total[5m])；status 区分 ok/error/aborted。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (agent) (rate(medassist_agent_consult_requests_total[5m]))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "问答错误率（近 5 分钟）",
      "description": "分母排除 prefilter（闲聊前置应答零模型、恒成功），与后端告警口径一致。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.2 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(medassist_agent_consult_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(medassist_agent_consult_requests_total{agent!=\"prefilter\"}[5m])), 0.001)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "同步问答 P95",
      "description": "histogram_quantile(0.95, sync channel)；流式含生成时间，不纳入。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 20 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(medassist_agent_consult_duration_seconds_bucket{channel=\"sync\"}[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Token 用量速率（input / output）",
      "description": "只统计 provider 真实返回的 usage；没有 usage 的请求不计入。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind) (rate(medassist_agent_consult_tokens_total[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "技能使用 top（近 5 分钟）",
      "description": "按技能码拆分；标签基数溢出时新技能归入 __other__（见 skill_labels_overflow）。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (skill) (rate(medassist_agent_skill_usage_total[5m]))",
          "legendFormat": "{{skill}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "PG 读 P95（按域/操作）",
      "description": "直方图（第 94 批）；P95>500ms 有告警，这里看趋势与热点。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, domain, op) (rate(medassist_agent_pg_query_duration_seconds_bucket[5m])))",
          "legendFormat": "{{domain}}/{{op}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PG 写 P95（按域/操作）",
      "description": "镜像写/全量同步/单行 UPSERT/删除（第 95–96 批）。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, domain, op) (rate(medassist_agent_pg_write_duration_seconds_bucket[5m])))",
          "legendFormat": "{{domain}}/{{op}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "PG 错误速率（读 / 写）",
      "description": "读失败 = 该域回落 JSON（可能滞后/多副本不一致）；写失败见第 95 批语义。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (domain) (rate(medassist_agent_pg_query_errors_total[5m]))",
          "legendFormat": "read/{{domain}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (domain) (rate(medassist_agent_pg_write_errors_total[5m]))",
          "legendFormat": "write/{{domain}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "存储与依赖状态",
      "description": "ready/circuit 为 1=正常；stale>0 表示有域写失败回落 JSON；redis_degraded=1 表示多副本语义失效。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "medassist_agent_storage_ready", "legendFormat": "storage_ready" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "medassist_agent_storage_circuit_open", "legendFormat": "circuit_open" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(medassist_agent_storage_stale_domains)", "legendFormat": "stale_domains" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "medassist_agent_redis_degraded", "legendFormat": "redis_degraded" },
        { "refId": "E", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "medassist_agent_milvus_reachable", "legendFormat": "milvus_reachable" }
      ]
    }
  ]
}
