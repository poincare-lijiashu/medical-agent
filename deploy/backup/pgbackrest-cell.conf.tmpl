# ============================================================================
# 每院 pgBackRest 配置模板（第 286 批 / ADR-001）
#
# 部署位置：Cell 内 pgBackRest 客户端容器（或数据库 Pod 的 sidecar），
# 渲染后为 /etc/pgbackrest/pgbackrest.conf，仅该院可见。
#
# 替换项（由控制面开通结果或 Helm values 注入）：
#   {{TENANT}}          租户编码 / stanza（如 tenant-003）
#   {{BUCKET}}          该院独立桶（默认 medassist-backup-<tenant>）
#   {{ENDPOINT}}        S3/MinIO 端点（如 https://s3.cn-east-1.example）
#   {{REGION}}          区域
#   {{ACCESS_KEY}}      仅该院的备份访问密钥（禁止全院共用）
#   {{SECRET_KEY}}      对应的 Secret
#   {{PITR_DAYS}}       PITR 保留天数（1-35，与控制台登记一致）
#   {{CIPHER_PASS}}     仓库加密口令（必须来自 KMS/Secret，不落镜像）
#
# 安全约束：
#   * 一院一桶 + 一院一密钥 + 一院一 stanza：恢复时不可能误取别院仓库；
#   * 加密口令丢失等于备份不可恢复，必须与数据库凭据分开保管；
#   * 本文件不写入任何真实凭据，渲染由 Secret 挂载完成。
# ============================================================================

[global]
repo1-type=s3
repo1-s3-endpoint={{ENDPOINT}}
repo1-s3-bucket={{BUCKET}}
repo1-s3-region={{REGION}}
repo1-s3-key={{ACCESS_KEY}}
repo1-s3-key-secret={{SECRET_KEY}}
repo1-path=/pgbackrest/{{TENANT}}
repo1-retention-full={{PITR_DAYS}}
repo1-retention-full-type=time
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass={{CIPHER_PASS}}
compress-type=zst
archive-async=y
start-fast=y
log-path=/var/log/pgbackrest
log-level-console=info
log-level-file=detail

[{{TENANT}}]
pg1-path=/var/lib/postgresql/data
pg1-port=5432

# ---------------------------------------------------------------------------
# PostgreSQL 侧（postgresql.conf；修改后需重启，archive_mode 不是 reload 参数）
#
# wal_level = replica
# archive_mode = on
# archive_command = 'pgbackrest --stanza={{TENANT}} archive-push %p'
# archive_timeout = 60
#
# 交付步骤（Cell 内）：
#   pgbackrest --stanza={{TENANT}} stanza-create
#   pgbackrest --stanza={{TENANT}} check
#   pgbackrest --stanza={{TENANT}} --type=full backup
#   # 恢复（演练必须使用独立实例/目录，绝不覆盖生产数据目录）：
#   pgbackrest --stanza={{TENANT}} --type=time \
#       --target="2026-11-12 14:00:00+08" --target-action=promote restore
#
# 控制面校验：开通 BACKUP 步骤会读取 archive_mode/wal_level/pg_stat_archiver，
# 只有 archive_mode=on 且归档成功过，健康度才显示"备份 已就绪"。
# 恢复演练：python scripts/e2e/backup_restore_drill.py（逻辑全量）, 
#            WAL 回放按上面的 pgbackrest --type=time 在演练实例执行。
# ---------------------------------------------------------------------------
