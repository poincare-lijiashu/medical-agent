# MedAssist 生产/部署配置模板 —— 复制为 .env.local 并填真实值（切勿把密钥提交进版本库）
APP_ENV=production
APP_VERSION=1.0.0
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# LLM：阿里云百炼 Qwen（OpenAI 兼容端点）
QWEN_API_KEY=<你的-Qwen-API-Key>
QWEN_BASE_URL=<MaaS-兼容端点-URL>
QWEN_MODEL_CHAT=qwen3.8-flash
QWEN_MODEL_REASONING=qwen3.8-max
QWEN_MODEL_CODER=qwen-coder-plus
QWEN_MODEL_VL=qwen3-vl-plus

# 基础设施
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=root:Milvus
PG_HOST=postgres
PG_PORT=5432
PG_USER=medagent
PG_PASSWORD=<强口令>
PG_DATABASE=medagent

# 轮 B2 可选 Redis（三级部署之二：院区级多实例）：留空=单机内存后端（默认，零配置）；
# 多实例部署填 redis://<host>:6379/0（docker-compose 取消 redis 服务注释块即可启用），
# 限流/会话记忆/令牌撤销改为跨实例共享。Redis 不可用自动回落本实例内存镜像，服务不中断。
# 启用后各实例必须使用同一 AUTH_JWT_SECRET，否则令牌跨实例失效。详见 docs/DEPLOY.md
REDIS_URL=

# docker-compose 基础设施凭证（终评 F6：compose 侧 ${POSTGRES_PASSWORD:-medagent123} /
# ${MINIO_SECRET_KEY:-minioadmin} 回落默认仅供本地开发——【生产必改】为强口令，
# 勿提交真实密码进版本库；PG 端口已仅绑 127.0.0.1）
MEDAGENT_PG_PASSWORD=<强口令-生产必改-对应-docker-compose-POSTGRES_PASSWORD>
MEDAGENT_MINIO_PASSWORD=<强口令-生产必改-对应-docker-compose-MINIO_SECRET_KEY>

# 模型权重（容器内以卷挂载到 /app/backend/models）
BGE_M3_PATH=models/embedding/bge-m3
RERANKER_PATH=models/reranker/bge-reranker-large

# 嵌入设备（任务6 可移植性，GPU 可选 CPU 回退）：auto=有 CUDA 用 GPU 否则 CPU（默认）；
# cpu=强制 CPU；cuda=优先 GPU、CUDA 不可用自动回落 CPU 并告警
EMBED_DEVICE=auto
# 视觉模型最大输出 token 数（默认 8192：4096 时长病例结构化描述仍可能截断；deepseek
# anthropic 兼容端点 max output 128K、qwen3-vl-plus 最大输出 32768，8192 均合法）
VL_MAX_TOKENS=8192
# PG_OFFLINE=on 仅用于 eval/脚本/测试等非服务进程（纯静默 JSON 真源、不置 stale 不告警）；
# 服务进程【不要】设置（留空即可）
# PG_OFFLINE=

# 鉴权
AUTH_JWT_SECRET=<openssl rand -hex 32 生成>
AUTH_TOKEN_EXPIRE_MINUTES=720
AUTH_REFRESH_EXPIRE_MINUTES=10080
RATE_LIMIT_PER_MIN=60
# 第 72 批：应用日志按进程分文件（app-<pid>.log）。单实例保持 false；多实例/多 worker
# 部署请置 true，否则多个进程会争用同一个 app.log 的轮转（Windows 报 WinError 32）。
LOG_FILE_PER_PROCESS=false
# 第 71 批：反向代理可信地址（逗号分隔 IP/CIDR）。留空=不采信 X-Forwarded-For。
# nginx 部署必须填直连代理地址（本机示例：127.0.0.1），否则匿名请求（登录等）
# 会全部落在 nginx 同一个 IP 桶里，60 次/分钟被全院共享。
TRUSTED_PROXIES=
AUTH_ENABLED=true
# 第 179 批：字段级静态加密密钥（base64 32 字节，openssl rand -base64 32）。
# 配置后 LLM 供应商 api_key 以 AES-256-GCM 密文落库（PG 与 data/llm_providers.json 同一口径）；
# 生产类环境（APP_ENV=production/prod/staging）未配置时**拒绝保存模型密钥**（fail-closed）。
# 本地开发可留空（保持明文，仅告警一次）。轮换：旧密钥保留在 Secret 历史版本即可解密旧数据。
SECRETS_ENCRYPTION_KEY=
# 第 181 批：多版本密钥环（配了就优先于上面的单密钥）。JSON：
# {"active":"k2","keys":{"k1":"<base64 32B>","k2":"<base64 32B>"}}
# 轮换不停写：新密钥加入 keys、active 指向新密钥 → 新写入用 enc:v2:k2，旧密文仍用 k1 解密；
# 确认存量升级完再从 keys 摘掉旧密钥（第 179 批的 enc:v1 旧密文在轮换期需保留旧密钥）。
SECRETS_ENCRYPTION_KEYS=
# Prometheus 抓取专用令牌（G105）：设置后 /metrics 接受 Bearer <METRICS_TOKEN>；
# 留空则仅 admin 登录态可读。生产用随机长串，且只写入 Prometheus 的 Secret/令牌文件。
METRICS_TOKEN=
# 技能运营指标快照（G94/M-28）：每天该时刻自动落一条聚合快照（本地时区）；
# 0 = 关闭自动快照（只保留管理端手动按钮）。启动时若当天缺失会立即补一条。
AGENT_SNAPSHOT_HOUR=1
AGENT_SNAPSHOT_MINUTE=10
# A2A 能力卡（评审 03-S7）：对外 URL 的可信基址；留空回落到请求 Host（仅开发环境建议留空）。
AGENT_PUBLIC_BASE_URL=
# 能力卡只披露这些能力域（逗号分隔）；留空=不披露（fail-closed）。
AGENT_CARD_DISCLOSED_AGENTS=literature,drug,kb
# 模型调用并发闸门（评审 03-S8）：进程内同时调用上限；满额排队该秒数后返回 503。
AGENT_MODEL_MAX_CONCURRENCY=4
AGENT_MODEL_QUEUE_TIMEOUT_S=10

# 质控自动化（QC_AUTO_PASS=AI 预筛三档分流；QC_AUTO_SIGN=中危规则库自动留痕；
# QC_AUTO_SIGN_FULL=留痕模式：审核队列入队即自动签发「AI·留痕模式(自动)」，含高危——全部自动，
# 医生侧不阻塞，高危项推提交医生知情确认；开启前需院方合规确认）
QC_AUTO_PASS=false
QC_AUTO_SIGN=true
# 评测 04 P0-4：默认关闭（高危结论必须人工双控；等保三级双人复核/权限分离）。
# 院方完成合规评估并书面确认后，显式改 true 或经 admin「留痕模式」开关卡开启（SOP 见 docs/DEPLOY.md）。
QC_AUTO_SIGN_FULL=false

# 应用日志落文件（on/off；空=默认全环境 on——开发也落文件便于 admin 日志健康卡排障，显式 off 才关闭）；
# 目录与轮转：5MB × 5 备份（logs/app.log）
LOG_TO_FILE=
LOG_DIR=logs

# 审计日期窗口的"业务时区"（IANA 名，如 Asia/Shanghai）。空=服务端本地时区（单机零配置）。
# ⚠ 容器默认 UTC：不配置时 admin「按日历日」筛选/导出会与本地日期偏 8 小时（跨零点数据算错一天）。
AUDIT_TIMEZONE=

# 请求体上限（MB）：Content-Length 超限直接 413（JSON 体 {"detail":"请求体过大（>NMB），请拆分文件"}）；
# KB 大教材 PDF（38.5MB）base64 后约 54MB，建议 64（与 KbUploadReq.data_b64 上限 90M 字符双保险）
MAX_BODY_MB=64

# HIS 对接适配器（backend/integration，默认 none=未对接 NullAdapter 空转；demo=内存假数据演示）；
# 对接真实医院时填厂商标识（registry.register_adapter 注册名）——新增厂商适配器步骤见 docs/INTEGRATION.md
HIS_ADAPTER=none

# ---- Nacos 服务注册（P0-5，计划书 D6.1）----
# 默认关闭；开启后 AI 中台以 medassist-ai-core 注册，供网关/Java 服务按服务名发现。
# 生产开启鉴权后必须填 NACOS_USERNAME / NACOS_PASSWORD；容器/多网卡环境必须显式指定
# NACOS_IP（否则自动探测可能注册回环地址，跨主机不可达）。
NACOS_ENABLED=false
NACOS_SERVER_ADDRESSES=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_SERVICE_NAME=medassist-ai-core
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_CLUSTER_NAME=DEFAULT
NACOS_WEIGHT=1.0
NACOS_IP=
NACOS_METADATA=

# ---- SkyWalking（P0-5）----
# 仅容器形态生效：entrypoint 检测到 SW_AGENT_COLLECTOR_BACKEND_SERVICES 非空时
# 用 sw-python 包装 uvicorn；本地直跑 uvicorn 时该变量无作用（不加载 agent）。
SW_AGENT_COLLECTOR_BACKEND_SERVICES=
SW_AGENT_NAME=medassist-ai-core
SW_AGENT_INSTANCE_NAME=
SW_AGENT_SAMPLE=10000

# ---- 授权对账（§289）----
# AI 中台把"今日成功问答次数"定时推给授权服务（直连 8095，不经网关）：
#   POST /internal/license/usage/ai   X-Internal-Token: <INTERNAL_API_TOKEN>
# 留空 = 不上报（离线/单机形态）；配置后授权页的 AI 配额使用率会随问答自动变化。
# 授权服务不可达不影响问答：计数留在本地 agent_usage_daily 台账，下一轮重试。
PLATFORM_LICENSE_BASE_URL=
INTERNAL_API_TOKEN=<与 Java 侧同一个内部令牌>
AI_USAGE_FLUSH_SECONDS=60

# ---- Java 平台 / 授权与许可（评测 D-22）----
# 生产（MEDASSIST_ENV=production 或 profile=prod/staging/k8s）以下三项为硬性要求，
# 缺失或被检测为演示值会拒绝启动：
#   LICENSE_INSTANCE_CODE   必须与授权书实例码一致（禁止沿用 MEDASSIST-DEV-0001）
#   LICENSE_DEPLOYMENT_MODE hospital（院方，禁止签发）| vendor（厂商，可签发）
#   LICENSE_ENFORCE         true（网关按授权拦截未授权模块；false 视为未启用授权）
LICENSE_INSTANCE_CODE=
LICENSE_DEPLOYMENT_MODE=hospital
LICENSE_ISSUANCE_ENABLED=false
LICENSE_ENFORCE=false
# 验签公钥（院方导入授权书时由厂商提供；留空则只校验本地授权书文件完整性）
LICENSE_VERIFY_KEY=

# ---- Java 平台 / 服务绑定（评测 S-01）----
# 服务间未启用签名校验（medassist.internal-auth.mode=off/log）时，必须只监听回环地址，
# 否则同网段任何主机都能伪造 X-Actor / X-Permissions 头读取 PHI。
# 单机/演示：127.0.0.1；容器/Helm：由编排层决定，并应改为 mode=enforce。
SERVER_ADDRESS=127.0.0.1

# ---- Java 平台 / 数据库（与 Python 侧同名变量共用）----
PG_HOST=127.0.0.1
PG_PORT=5433
PG_SSLMODE=prefer
