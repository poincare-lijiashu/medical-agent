# MedAssist 生产/部署配置模板 —— 复制为 .env.local 并填真实值（切勿把密钥提交进版本库）
APP_ENV=production
APP_VERSION=1.0.0
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# LLM：阿里云百炼 Qwen（OpenAI 兼容端点）
QWEN_API_KEY=<你的-Qwen-API-Key>
QWEN_BASE_URL=<MaaS-兼容端点-URL>
QWEN_MODEL_CHAT=qwen3.8-flash
QWEN_MODEL_REASONING=qwen3.8-max
QWEN_MODEL_CODER=qwen-coder-plus
QWEN_MODEL_VL=qwen3-vl-plus

# 基础设施
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=root:Milvus
PG_HOST=postgres
PG_PORT=5432
PG_USER=medagent
PG_PASSWORD=<强口令>
PG_DATABASE=medagent

# 模型权重（容器内以卷挂载到 /app/backend/models）
BGE_M3_PATH=models/embedding/bge-m3
RERANKER_PATH=models/reranker/bge-reranker-large

# 鉴权
AUTH_JWT_SECRET=<openssl rand -hex 32 生成>
AUTH_TOKEN_EXPIRE_MINUTES=720
AUTH_REFRESH_EXPIRE_MINUTES=10080
RATE_LIMIT_PER_MIN=60
AUTH_ENABLED=true
