# MedAssist 配置模板 —— 复制为 .env.local 并填真实值（切勿把密钥提交进版本库）
#
# ── 快速上手（docker compose up -d 即可跑通）───────────────────────────────
APP_ENV=development            # 生产部署改 production 并设 AUTH_JWT_SECRET（见 docs/DEPLOY.md）
APP_VERSION=1.0.0
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# ── LLM（必填 1 项）：支持任意 OpenAI 兼容服务 ─────────────────────────────
# 填你的 API Key 即可（阿里云百炼 / DeepSeek / 智谱 / Kimi / OpenAI / 本地 Ollama+网关…）
LLM_API_KEY=<你的-OpenAI-兼容-API-Key>
# 可选：覆盖端点与对话模型名（默认走阿里云百炼兼容端点 + qwen-plus）
#   DeepSeek 示例：LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
#   百炼示例：    LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 视觉模型（影像/病例多模态用；留空=qwen3-vl-plus，换厂商时同步改）
# QWEN_MODEL_VL=qwen3-vl-plus
# 历史键名 QWEN_API_KEY/QWEN_BASE_URL/QWEN_MODEL_* 兼容保留，显式配置优先于上方别名

# ── 种子账号（首次启动自动注入 4 个账号；登录后请立即改密）────────────────
AUTH_SEED_DEMO=true
AUTH_DEMO_PASSWORD=Med@2026
# 生产部署：AUTH_SEED_DEMO=false、AUTH_JWT_SECRET=<openssl rand -hex 32>（生产模板见 docs/DEPLOY.md）
# AUTH_JWT_SECRET=
AUTH_TOKEN_EXPIRE_MINUTES=720
AUTH_REFRESH_EXPIRE_MINUTES=10080
RATE_LIMIT_PER_MIN=60
AUTH_ENABLED=true

# ── 嵌入模型（首次使用自动从 HuggingFace 下载 BGE-M3 约 2GB）────────────────
# HF_ENDPOINT 已配国内镜像（网络可达官方站可删除此行）；下载一次后缓存复用
HF_ENDPOINT=https://hf-mirror.com
BGE_M3_PATH=BAAI/bge-m3
# 本地已有权重时改为本地路径（如 models/embedding/bge-m3，卷挂载 backend/models/）
# RERANKER_PATH=
EMBED_DEVICE=auto              # auto=有 CUDA 用 GPU 否则 CPU；cpu=强制 CPU；cuda=优先 GPU
# 视觉模型最大输出 token 数（默认 8192）
VL_MAX_TOKENS=8192

# ── 基础设施（docker compose 已含 Milvus/PG/Attu，端口仅绑 127.0.0.1）───────
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=root:Milvus
PG_HOST=postgres
PG_PORT=5432
PG_USER=medagent
PG_PASSWORD=medagent123        # 生产必改强口令（与 compose 的 POSTGRES_PASSWORD 保持一致）
PG_DATABASE=medagent

# docker-compose 基础设施凭证（默认值仅供本地开发——【生产必改】为强口令，
# 勿提交真实密码进版本库；PG/MinIO 端口已仅绑 127.0.0.1）
POSTGRES_PASSWORD=medagent123
MEDAGENT_PG_PASSWORD=medagent123
MEDAGENT_MINIO_PASSWORD=minioadmin

# 轮 B2 可选 Redis（三级部署之二：院区级多实例）：留空=单机内存后端（默认，零配置）；
# 多实例部署填 redis://<host>:6379/0（docker-compose 取消 redis 服务注释块即可启用），
# 限流/会话记忆/令牌撤销改为跨实例共享。Redis 不可用自动回落本实例内存镜像，服务不中断。
# 启用后各实例必须使用同一 AUTH_JWT_SECRET，否则令牌跨实例失效。详见 docs/DEPLOY.md
REDIS_URL=

# 应用日志落文件（on/off；空=默认全环境 on——开发也落文件便于 admin 日志健康卡排障，显式 off 才关闭）；
# 目录与轮转：5MB × 5 备份（logs/app.log）
LOG_TO_FILE=
LOG_DIR=logs

# 请求体上限（MB）：Content-Length 超限直接 413（JSON 体 {"detail":"请求体过大（>NMB），请拆分文件"}）；
# KB 大教材 PDF（38.5MB）base64 后约 54MB，建议 64（与 KbUploadReq.data_b64 上限 90M 字符双保险）
MAX_BODY_MB=64

# 质控自动化（QC_AUTO_PASS=AI 预筛三档分流；QC_AUTO_SIGN=中危规则库自动留痕；
# QC_AUTO_SIGN_FULL=留痕模式：审核队列入队即自动签发「AI·留痕模式(自动)」，含高危——全部自动，
# 医生侧不阻塞，高危项推提交医生知情确认；开启前需院方合规确认）
QC_AUTO_PASS=false
QC_AUTO_SIGN=true
QC_AUTO_SIGN_FULL=true

# HIS 对接适配器（backend/integration，默认 none=未对接 NullAdapter 空转）；
# 对接真实医院时填厂商标识（registry.register_adapter 注册名）——新增厂商适配器步骤见 docs/archive/INTEGRATION.md
HIS_ADAPTER=none
