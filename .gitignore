# ===== 医疗项目红线：密钥 / 隐私 / 大文件，严禁入库 =====

# 密钥与本地配置（含 QWEN_API_KEY、AUTH_JWT_SECRET）
.env.local
*.key
*.pem
# G105：Prometheus 抓取令牌（本地生成，不进版本库）
deploy/observability/prometheus/metrics-token

# 用户隐私数据（密码哈希 / 审计日志含 PHI / 审核队列含病历）
data/auth/
data/audit/
data/review/
# 含病例原文的业务数据（评测 B5）：此前被跟踪（consults 12 次提交 / prescriptions 16 次），
# 属于已发生的泄露面。本批起停止跟踪，历史清理另走 git filter-repo 流程（需团队确认后执行）。
# 注意：文件仍在本地磁盘上（运行时真源/JSON 兜底），只是不再进版本库。
data/consults.json
data/prescriptions.json
data/case_archive.json

# 备份产物（backup.py/restore.py 的 tar.gz 含全量业务数据，严禁入库）
data/backups/

# 模型配置（含第三方 API Key，严禁入库）
data/llm_providers.json
# 运行时开关状态（admin 面板切换写入；值等于 settings 默认时本就不需要落盘，
# E2E 开关键用例每次跑都会往文件里补键 → 属于运行时产物，不入库）
data/runtime_flags.json
# 运营指标按日快照（运行时产物：由定时任务/手动触发写入，不入库）
data/skill_metrics_snapshots.json
# 睡眠记忆体检报告（运行时产物：每次 scan 追加，最多 20 份，不入库）
data/sleep_memory_reports.json
# Agent 技能卡 JSON 镜像（PG 为真源，JSON 只是灾难镜像；运行时生成，不入库）
data/agent_skills.json
data/agent_bots.json
data/bot_teams.json
data/bot_memories.json
data/skill_experiences.json
data/skill_proposals.json
data/skill_advices.json

# 临时产物（安装/种子过程错误日志与一次性验证输出）
data/*.err
data/*.log
data/*.tmp
# 评测 P0-4：JSON 镜像跨进程锁的旁路文件（运行时生成，不入库）
data/*.lock
data/verify_out.txt

# 阶段5 PubMed 扩容拉取缓存（9.7MB 大文件不入库；可在线再生成，离线复现走
# 脚本降级路径：Milvus 既有 pubmed_seed 行滑窗切分）
data/kb/pubmed_v2_cache.json
data/kb/pubmed_v2_run.log
# PubMed 拉取缓存（两段式语料包：可达环境产出→内网 MEDICAL_OFFLINE_JSON 离线入库；
# 摘要内容有版权灰度，分发走私有通道，不入公开仓）
data/kb/pubmed_seed_cache.json

# KB 语料原件（版权教材 PDF 等，80MB+ 不入库；向量已入 Milvus，原件由部署方自备）
data/kb_docs/*.pdf
data/kb_docs/*.docx

# 模型权重（4.3GB，本地化部署不入库）
backend/models/

# ===== 常规排除 =====
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.vscode/
.idea/
node_modules/
dist/
# Java/Maven（platform/*）：构建产物（含 Spring Boot fat jar 与 class 文件）不入库
platform/**/target/
*.class
# Vue3 迁移（轮1）：前端 dist 构建产物随轮提交（回退免 node 环境，手册既定策略）；
# node_modules 仍由上方规则排除。注意：上方 `dist/` 是目录通配，需显式反向豁免。
# 第 183 批：临床控制台为唯一前端，产物同策略入库——部署镜像免 node 环境，
# 回退时可直接用已构建产物。注意必须写成两条：目录豁免 + 目录内文件豁免。
!frontend-console/dist/
!frontend-console/dist/**
*.log
# G51：运行期日志目录整目录排除。
# 仅 `*.log` 挡不住滚动归档（svc_emr.log.2026-11-04.0.gz）与 *_try.out.log，
# 而日志里含明文演示口令（auth.seed.demo_password 等），一旦被 `git add -A` 归档
# 就等于把凭据写进版本历史。
logs/
*.log.*
*.log.gz
.DS_Store

# 第 279 批：授权签发密钥（开发环境自动生成）。私钥一旦入库等于把"给自己发证"的能力
# 交给任何拿到仓库的人；生产应改由 KMS/HSM 或环境变量注入，落盘目录永不入库。
data/license/

# 第 283 批：验收/演练证据（每次执行生成，含主机名与延迟采样）。报告正文写死结论与数字，
# 原始 JSON 留在本机按需归档；对外提交时把快照放 docs/evidence/ 而不是整目录入库。
artifacts/
